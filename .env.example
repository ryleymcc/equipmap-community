# Copy to .env. Generate three independent random values (hex avoids URL escaping).
# python -c "import secrets; print(secrets.token_hex(32))"
DB_USER=equipmap
DB_NAME=equipmap
DB_PASSWORD=
SECRET_KEY=
# Needed on the FIRST startup of an empty database; username is admin.
INITIAL_ADMIN_PASSWORD=
# Local preview defaults. For a public server use your domain and 0.0.0.0 binds.
EQUIPMAP_ADDRESS=http://localhost
HTTP_BIND=127.0.0.1
HTTPS_BIND=127.0.0.1
# Optional monitoring; disabled unless you supply your own destinations.
SENTRY_DSN=
VITE_SENTRY_DSN=
CHATGPT_ENABLED=false
CHATGPT_PUBLIC_URL=
CHATGPT_FRONTEND_URL=
CHATGPT_CLIENT_ID=equipmap-chatgpt
CHATGPT_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
