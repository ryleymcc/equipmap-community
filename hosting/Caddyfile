{$EQUIPMAP_ADDRESS:http://localhost} {
    request_body {
        max_size 100MB
    }
    @backend path /api /api/* /uploads /uploads/* /health /docs /swag /swagger /api-docs /openapi.json /mcp /mcp/* /.well-known/*
    handle @backend {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:80
    }
}
